{
    "name": "rocketgate-sdk",
    "version": "1.1.0",
    "description": "SDK for the RocketGate Payment Gateway",
    "main": "index.js",
    "files": [
        "index.js",
        "lib/",
        "config/config.js",
        "config/rgProperties.json",
        "CHANGELOG.md"
    ],
    "engines": {
        "node": ">=16"
    },
    "author": "RocketGate",
    "contributors": [
        {
            "name": "Alison Boden",
            "email": "alisonboden@gmail.com"
        },
        {
            "name": "Zeph LaFassett",
            "email": "zephlafassett@gmail.com"
        }
    ],
    "scripts": {
        "test": "nyc --hook-run-in-context --reporter=html --reporter=text --check-coverage --lines=77 --statements=77 node scripts/test-unit.js",
        "test:integration": "nyc --reporter=html --reporter=text --check-coverage --lines=77 --statements=77 node node_modules/mocha/bin/_mocha --opts test/integration/mocha.opts --timeout 5000 test/integration"
    },
    "nyc": {
        "include": ["index.js", "lib/**/*.js", "config/config.js"]
    },
    "keywords": [
        "rocketgate",
        "gateway",
        "payment"
    ],
    "dependencies": {
        "async": "~2.6.4",
        "fast-xml-parser": "~5.11.2",
        "request": "2.76.x",
        "urlencode": "1.1.x"
    },
    "devDependencies": {
        "eslint": "^3.17.1",
        "eslint-plugin-jsdoc": "^2.4.0",
        "eslint-plugin-security": "^1.3.0",
        "mocha": "^3.5.3",
        "nyc": "^10.1.2",
        "should": "^11.2.1"
    }
}
